# Cloudflare Pages security headers (brief §11, target A grade).
# Static export can't set next.config headers on CF, so they live here.

# next/og emits the social cards as extensionless files, so CF has no suffix
# to infer a MIME type from. With nosniff set below, an unlabelled response
# is refused by scrapers — name the type explicitly.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600

/twitter-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.web3forms.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
